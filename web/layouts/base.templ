package layouts

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<script src="/static/js/htmx.min.js"></script>
		</head>
		<body>
			<header>
				<a href="/">Flow</a>
				<nav>
					<a href="/">Home</a>
					<a href="/pipelines">Pipelines</a>
				</nav>
			</header>
			<main>
				{ children... }
			</main>
			<footer>
				Footer
			</footer>
		</body>
	</html>
}
